# انسخ الملف ده لحسابك على Render باسم "Environment Variables" -- ماتحطش القيم هنا في Git

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...          # من BotFather
TELEGRAM_CHAT_ID=your_chat_id_here            # الشات اللي هيوصلك عليه المسودات
TELEGRAM_LOG_CHAT_ID=your_log_chat_id_here    # (اختياري) قناة/شات لأرشفة المعتمد، لو فاضي هيستخدم نفس TELEGRAM_CHAT_ID
GEMINI_API_KEY=your_gemini_api_key_here       # من aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash                 # موديل مجاني، غيّره لو حابب
GENERATE_SECRET=اختار-كلمة-سر-طويلة-وعشوائية   # بيحمي رابط /generate
WEBHOOK_SECRET_PATH=اختار-نص-عشوائي-تاني       # بيحمي رابط الويبهوك
CONTENT_NICHE=محتوى شخصي / إنفلونسر عام        # عدّلها لمجالك بالضبط
